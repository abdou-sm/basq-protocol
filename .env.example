# Testnet deployment (copy to .env, never commit the real one)
PRIVATE_KEY=0x...
OWNER=0xYourMultisigOrEOA
PLATFORM=0xProtocolTreasury
# Minimum platform cut enforced on every basket (bps of creator flow, 1-5000)
MIN_PLATFORM_SHARE_BPS=2000
# Faucet stock tokens (TSLA, AMZN, ...) from https://faucet.testnet.chain.robinhood.com/
STOCK_TOKENS=0xTokenA,0xTokenB
# 6-decimal USD value per whole token, same order (e.g. $400 -> 400000000)
STOCK_PRICES=400000000,200000000
CREATE_FIRST=true
FIRST_NAME=Testnet Basket
FIRST_SYMBOL=TBKT
# --- Real USDG migration (script/MigrateUsdg.s.sol) ---
# Official Paxos USDG on Robinhood Testnet; claim at https://faucet.paxos.com/
# Usage: forge script script/MigrateUsdg.s.sol:MigrateUsdg \
#   --sig "run(address,address,address)" <EXEC_REGISTRY> <ORACLE> <ADAPTER> \
#   --rpc-url robinhood_testnet --broadcast
USDG_ADDRESS=0x7E955252E15c84f5768B83c41a71F9eba181802F
# Raw units of real USDG to seed adapter inventory (6 decimals, e.g. 1000 USDG -> 1000000000)
SEED_USDG=0
# Public testnet RPC (rate-limited). Prefer Alchemy: https://robinhood-testnet.g.alchemy.com/v2/$KEY
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
